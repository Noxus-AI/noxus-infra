{
  "uid": "noxus-liquid-storage",
  "title": "Noxus \u2014 Liquid Storage (run-state)",
  "tags": [
    "noxus",
    "storage",
    "cache",
    "liquid"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Reads",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Reads / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_reads_total[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_reads_total{source=\"memory\"}[$__rate_interval])) / (sum(rate(noxus_storage_reads_total[$__rate_interval])) > 0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cold-read rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_reads_total{source=\"cold\"}[$__rate_interval])) / (sum(rate(noxus_storage_reads_total[$__rate_interval])) > 0)",
          "refId": "A"
        }
      ],
      "description": "Fraction of reads that fell through to S3 \u2014 high means caches are cold/evicting."
    },
    {
      "type": "stat",
      "title": "Miss rate (not_found)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_reads_total{source=\"not_found\"}[$__rate_interval])) / (sum(rate(noxus_storage_reads_total[$__rate_interval])) > 0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Archive empty rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_archive_total{result=\"empty\"}[$__rate_interval])) / (sum(rate(noxus_storage_archive_total[$__rate_interval])) > 0)",
          "refId": "A"
        }
      ],
      "description": "Fraction of archive attempts that found nothing in hot storage (result=empty) \u2014 usually benign (pause/resume, already archived)."
    },
    {
      "type": "timeseries",
      "title": "Read source mix / s (memory/hot/cold/miss)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_reads_total[$__rate_interval])) by (source)",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "description": "memory/hot/cold are hits; not_found is a miss."
    },
    {
      "type": "timeseries",
      "title": "Reads / s by component",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_reads_total[$__rate_interval])) by (storage_type)",
          "legendFormat": "{{storage_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory hit ratio by component",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_reads_total{source=\"memory\"}[$__rate_interval])) by (storage_type) / (sum(rate(noxus_storage_reads_total[$__rate_interval])) by (storage_type) > 0)",
          "legendFormat": "{{storage_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Read latency p95 by source layer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(noxus_storage_read_seconds_bucket[$__rate_interval])) by (le, source))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Hydrations (cold/hot \u2192 faster layer)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "timeseries",
      "title": "Hydrations / s by target layer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_hydrations_total[$__rate_interval])) by (to_layer)",
          "legendFormat": "\u2192 {{to_layer}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hydration write latency p95 by component",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(noxus_storage_hydration_seconds_bucket[$__rate_interval])) by (le, storage_type))",
          "legendFormat": "{{storage_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Archival (\u2192 cold storage)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "timeseries",
      "title": "Archive latency p95 by component",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(noxus_storage_archive_seconds_bucket[$__rate_interval])) by (le, storage_type))",
          "legendFormat": "{{storage_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Archive outcomes / s by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_storage_archive_total[$__rate_interval])) by (storage_type, result)",
          "legendFormat": "{{storage_type}} {{result}}",
          "refId": "A"
        }
      ]
    }
  ]
}
