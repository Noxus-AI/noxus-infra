{
  "uid": "noxus-engine-workers",
  "title": "Noxus \u2014 Execution Engine & Workers",
  "tags": [
    "noxus",
    "workers",
    "engine"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(noxus_pq_jobs_pending, queue)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Workers online",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(noxus_pq_workers_online)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs in flight (parallelism)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(max by (queue) (noxus_pq_jobs_doing))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs pending",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(max by (queue) (noxus_pq_jobs_pending))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active runs",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(max by (kind) (noxus_runs_active))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest pending job (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(noxus_pq_oldest_pending_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Stalled jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(max by (queue) (noxus_pq_jobs_stalled))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Time to start (pickup latency)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Run queue wait (creation \u2192 start) \u2014 p50/p95/p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(noxus_run_queue_wait_seconds_bucket[$__rate_interval])) by (le, kind))",
          "legendFormat": "p50 {{kind}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(noxus_run_queue_wait_seconds_bucket[$__rate_interval])) by (le, kind))",
          "legendFormat": "p95 {{kind}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(noxus_run_queue_wait_seconds_bucket[$__rate_interval])) by (le, kind))",
          "legendFormat": "p99 {{kind}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Oldest queued run age by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max by (kind) (noxus_runs_oldest_queued_seconds)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Queues & parallelism",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Pending jobs by queue",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "max by (queue) (noxus_pq_jobs_pending{queue=~\"$queue\"})",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs executing by queue",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "max by (queue) (noxus_pq_jobs_doing{queue=~\"$queue\"})",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending per worker (KEDA target \u2248 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum(max by (queue) (noxus_pq_jobs_pending)) / clamp_min(max(noxus_pq_workers_online), 1)",
          "legendFormat": "pending/worker",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Runs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Run transitions / s by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_run_transitions_total[$__rate_interval])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run total time p95 by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(noxus_run_total_seconds_bucket[$__rate_interval])) by (le, kind))",
          "legendFormat": "p95 {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Nodes",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "title": "Node executions / s by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_node_executions_total[$__rate_interval])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest node types (p95 duration)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(noxus_node_duration_seconds_bucket[$__rate_interval])) by (le, node_type)))",
          "legendFormat": "{{node_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node retries & failures / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_node_retries_total[$__rate_interval]))",
          "legendFormat": "retries",
          "refId": "A"
        },
        {
          "expr": "sum(rate(noxus_node_executions_total{result=\"failed\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(noxus_node_executions_total{result=\"timeout\"}[$__rate_interval]))",
          "legendFormat": "timeout",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Process & loop health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      }
    },
    {
      "type": "timeseries",
      "title": "Worker respawns / s by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_worker_respawns_total[$__rate_interval])) by (reason, pool)",
          "legendFormat": "{{pool}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event-loop lag p99 by service",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(noxus_eventloop_lag_seconds_bucket[$__rate_interval])) by (le, service))",
          "legendFormat": "p99 {{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Recovery, fan-out & streams",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 58
      }
    },
    {
      "type": "timeseries",
      "title": "Stalled-job safety net (recoveries & activations / s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 59
      },
      "targets": [
        {
          "expr": "sum(rate(noxus_stalled_jobs_recovered_total[$__rate_interval]))",
          "legendFormat": "jobs recovered",
          "refId": "A"
        },
        {
          "expr": "sum(rate(noxus_stalled_safety_net_runs_total[$__rate_interval]))",
          "legendFormat": "safety-net activations",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node iteration fan-out p95 + worker memory recycles / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 59
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(noxus_node_iteration_width_bucket[$__rate_interval])) by (le))",
          "legendFormat": "fan-out p95",
          "refId": "A"
        },
        {
          "expr": "sum(rate(noxus_worker_memory_recycles_total[$__rate_interval])) by (task_type)",
          "legendFormat": "recycle {{task_type}} /s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active run streams + disconnects / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 67
      },
      "targets": [
        {
          "expr": "sum(noxus_stream_connections_active) by (stream)",
          "legendFormat": "active {{stream}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(noxus_stream_disconnects_total[$__rate_interval])) by (reason)",
          "legendFormat": "{{reason}} /s",
          "refId": "B"
        }
      ]
    }
  ]
}
